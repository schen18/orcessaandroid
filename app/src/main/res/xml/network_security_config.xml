<?xml version="1.0" encoding="utf-8"?>
<!--
  Allow cleartext HTTP ONLY to the embedded loopback server.
  Since Android 9 (API 28) cleartext is blocked app-wide by default; this
  scopes the exception to 127.0.0.1 and localhost so nothing else is exposed.
  The NanoHTTPD server binds to 127.0.0.1 only (not 0.0.0.0).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
