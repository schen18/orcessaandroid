<?xml version="1.0" encoding="utf-8"?>
<!--
  Simple launcher foreground: a stylized grid (Orca) with an accent square
  (SpessaSynth) in the center. Drawn as a vector so it scales crisply.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 3x3 grid of cells, leaving the adaptive-icon safe-zone (66dp center) -->
    <path android:fillColor="#72DEC2"
        android:pathData="
            M39,39 h6 v6 h-6 z
            M51,39 h6 v6 h-6 z
            M63,39 h6 v6 h-6 z
            M39,51 h6 v6 h-6 z
            M63,51 h6 v6 h-6 z
            M39,63 h6 v6 h-6 z
            M51,63 h6 v6 h-6 z
            M63,63 h6 v6 h-6 z" />
    <!-- center accent cell -->
    <path android:fillColor="#FFB545" android:pathData="M51,51 h6 v6 h-6 z" />
</vector>
