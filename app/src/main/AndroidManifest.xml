<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET is required even for loopback (127.0.0.1) socket operations on
      Android. Because the embedded server binds ONLY to 127.0.0.1, no other app
      on the device can reach it — this permission does not expose any data
      over Wi-Fi/cellular.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      ──────────────────────────────────────────────────────────────────────
      BACKGROUND AUDIO UPGRADE PATH (not enabled in v1)
      To keep audio playing when the app is backgrounded, uncomment the two
      permissions below and add a <service> with foregroundServiceType=
      "mediaPlayback" that holds a wake lock. See README-ANDROID.md.
      ──────────────────────────────────────────────────────────────────────
      <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
      <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
      <uses-permission android:name="android.permission.WAKE_LOCK" />
    -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.SpressOrca">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:exported="true"
            android:label="@string/app_name">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          BACKGROUND AUDIO UPGRADE PATH (not enabled in v1)
          <service
              android:name=".AudioService"
              android:exported="false"
              android:foregroundServiceType="mediaPlayback" />
        -->
    </application>
</manifest>
